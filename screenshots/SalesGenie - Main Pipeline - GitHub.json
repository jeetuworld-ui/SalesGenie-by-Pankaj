    {
      "parameters": {
        "promptType": "define",
        "text": "=You are the SalesGenie Intake Agent for Oak & Ember Interiors.\n\nRead the customer inquiry below.\n\nCustomer inquiry:\n{{ $json.inquiry_text }}\n\nChoose exactly one request_type:\n- sales_inquiry: customer wants to buy furniture or requests recommendations\n- product_question: customer asks about an existing product, such as price, color, features, or availability\n- spam: meaningless, suspicious, promotional, or spam-like text\n- weekly_summary: customer requests a weekly sales summary\n\nExtract only facts directly stated in the inquiry. Do not invent details.\n\nReturn one raw JSON object only.\nDo not add Markdown, explanation, code fences, or an outer \"output\" field.\n\nUse \"\" for unknown text values.\nUse 0 for unknown quantity or budget.\nUse [] when there are no requirements.\n\nUse this exact structure:\n{\n  \"request_type\": \"sales_inquiry\",\n  \"customer_name\": \"\",\n  \"email\": \"\",\n  \"company\": \"\",\n  \"product_interest\": \"\",\n  \"quantity\": 0,\n  \"budget_total\": 0,\n  \"urgency\": \"\",\n  \"requirements\": [],\n  \"competitor_mentioned\": false,\n  \"is_valid_inquiry\": true\n}",
        "hasOutputParser": true,
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
